#version 450

// Copies the last token column of x [N,T] (GGML layout) into out [N,1].
layout(local_size_x = 64) in;
layout(binding = 0) readonly  buffer X { float x[]; };
layout(binding = 1) writeonly buffer O { float o[]; };
layout(push_constant) uniform P { uint n; uint t; uint base; } p;

void main() {
    uint i = gl_GlobalInvocationID.x + p.base;
    if (i >= p.n) { return; }
    o[i] = x[i + (p.t - 1u) * p.n];
}
