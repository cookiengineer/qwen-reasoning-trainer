#version 450

// Tiled FlashAttention over a head-major Q8_0 KV cache.
//
// One workgroup handles QB consecutive queries for one KV head. Each step
// dequantizes a KT-key tile of K (then V) into shared memory once and reuses it
// for all queries in the block. The QK phase keeps four accumulators per lane
// and the PV phase keeps four value-dimension accumulators, so the inner loops
// have instruction-level parallelism instead of a serial dot chain.
//
// Dispatch is [queryBlocks, nHead]. This shader requires headDim == 256.

layout(local_size_x = 64) in;

layout(binding = 0) readonly  buffer Q { float q[]; };
layout(binding = 1) readonly  buffer K { uint data[]; } kbuf;
layout(binding = 2) readonly  buffer V { uint data[]; } vbuf;
layout(binding = 3) writeonly buffer O { float o[]; };

layout(push_constant) uniform P {
    uint  headDim;
    uint  nQ;
    uint  nHead;
    uint  nHeadKV;
    uint  nKV;
    uint  capacity;
    uint  qStart;
    float scale;
} p;

#define LS 64
#define QB 16
#define KT 16
#define HD 256

shared float qs[QB][HD + 1];
shared float acc[QB][HD + 1];
shared float ktile[KT][HD + 1];
shared float logits[QB][KT + 1];
shared float ss[KT][8];
shared float sm[KT][8];
shared float mval[QB];
shared float lval[QB];
shared float corr[QB];

uint getbK(uint o) { return (kbuf.data[o >> 2u] >> ((o & 3u) * 8u)) & 0xFFu; }
uint getbV(uint o) { return (vbuf.data[o >> 2u] >> ((o & 3u) * 8u)) & 0xFFu; }
float f16K(uint o) { return unpackHalf2x16(getbK(o) | (getbK(o + 1u) << 8u)).x; }
float f16V(uint o) { return unpackHalf2x16(getbV(o) | (getbV(o + 1u) << 8u)).x; }

void loadScales(uint tokenBase, bool useV, uint e) {
    for (uint s = 0u; s < 8u; s++) {
        uint base = tokenBase + s * 34u;
        ss[e][s] = useV ? f16V(base) : f16K(base);
        sm[e][s] = 0.0;
    }
}

void main() {
    uint h = gl_WorkGroupID.y;
    uint i0 = gl_WorkGroupID.x * QB;
    if (h >= p.nHead || i0 >= p.nQ) {
        return;
    }
    if (p.headDim != HD) {
        return;
    }
    uint group = p.nHead / p.nHeadKV;
    uint kv = h / group;
    uint lane = gl_LocalInvocationID.x;

    for (uint qi = 0u; qi < QB; qi++) {
        uint i = i0 + qi;
        if (i < p.nQ) {
            uint qOff = (i * p.nHead + h) * HD;
            for (uint d = lane; d < HD; d += LS) {
                qs[qi][d] = q[qOff + d];
                acc[qi][d] = 0.0;
            }
        } else {
            for (uint d = lane; d < HD; d += LS) {
                qs[qi][d] = 0.0;
                acc[qi][d] = 0.0;
            }
        }
    }
    if (lane < QB) {
        mval[lane] = -1e30;
        lval[lane] = 0.0;
        corr[lane] = 1.0;
    }
    barrier();

    uint lastI = min(i0 + QB - 1u, p.nQ - 1u);
    uint maxJBlock = min(p.nKV, p.qStart + lastI + 1u);
    for (uint t0 = 0u; t0 < maxJBlock; t0 += KT) {
        uint tlen = min(uint(KT), maxJBlock - t0);

        if (lane < KT) {
            uint e = lane;
            if (e < tlen) {
                uint base = (kv * p.capacity + (t0 + e)) * 8u * 34u;
                loadScales(base, false, e);
            } else {
                for (uint s = 0u; s < 8u; s++) {
                    ss[e][s] = 0.0;
                    sm[e][s] = 0.0;
                }
            }
        }
        barrier();

        for (uint idx = lane; idx < KT * HD; idx += LS) {
            uint e = idx / HD;
            uint d = idx - e * HD;
            if (e < tlen) {
                uint base = (kv * p.capacity + (t0 + e)) * 8u * 34u;
                uint sub = d / 32u;
                uint l = d % 32u;
                uint qv = getbK(base + sub * 34u + 2u + l);
                int q = int(qv);
                if (q >= 128) q -= 256;
                ktile[e][d] = ss[e][sub] * float(q);
            } else {
                ktile[e][d] = 0.0;
            }
        }
        barrier();

        uint e = lane / 4u;
        uint qi0 = (lane % 4u) * 4u;
        float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
        for (uint d = 0u; d < HD; d++) {
            float kval = ktile[e][d];
            a0 += qs[qi0 + 0u][d] * kval;
            a1 += qs[qi0 + 1u][d] * kval;
            a2 += qs[qi0 + 2u][d] * kval;
            a3 += qs[qi0 + 3u][d] * kval;
        }
        uint maxJ = t0 + e;
        for (uint qq = 0u; qq < 4u; qq++) {
            uint qi = qi0 + qq;
            uint i = i0 + qi;
            uint limit = min(p.nKV, p.qStart + i + 1u);
            float dot = qq == 0u ? a0 : (qq == 1u ? a1 : (qq == 2u ? a2 : a3));
            logits[qi][e] = (i < p.nQ && e < tlen && maxJ < limit) ? dot * p.scale : -1e30;
        }
        barrier();

        if (lane < QB) {
            uint qi = lane;
            uint i = i0 + qi;
            if (i < p.nQ) {
                float tileMax = -1e30;
                for (uint j = 0u; j < tlen; j++) {
                    tileMax = max(tileMax, logits[qi][j]);
                }
                float newM = max(mval[qi], tileMax);
                float c = exp(mval[qi] - newM);
                float sum = 0.0;
                for (uint j = 0u; j < tlen; j++) {
                    float pe = exp(logits[qi][j] - newM);
                    logits[qi][j] = pe;
                    sum += pe;
                }
                lval[qi] = lval[qi] * c + sum;
                mval[qi] = newM;
                corr[qi] = c;
            } else {
                corr[qi] = 1.0;
            }
        }
        barrier();

        if (lane < KT) {
            uint ve = lane;
            if (ve < tlen) {
                uint base = (kv * p.capacity + (t0 + ve)) * 8u * 34u;
                loadScales(base, true, ve);
            } else {
                for (uint s = 0u; s < 8u; s++) {
                    ss[ve][s] = 0.0;
                    sm[ve][s] = 0.0;
                }
            }
        }
        barrier();

        for (uint idx = lane; idx < KT * HD; idx += LS) {
            uint ve = idx / HD;
            uint d = idx - ve * HD;
            if (ve < tlen) {
                uint base = (kv * p.capacity + (t0 + ve)) * 8u * 34u;
                uint sub = d / 32u;
                uint l = d % 32u;
                uint qv = getbV(base + sub * 34u + 2u + l);
                int q = int(qv);
                if (q >= 128) q -= 256;
                ktile[ve][d] = ss[ve][sub] * float(q);
            } else {
                ktile[ve][d] = 0.0;
            }
        }
        barrier();

        uint d0 = lane;
        uint d1 = lane + LS;
        uint d2 = lane + 2u * LS;
        uint d3 = lane + 3u * LS;
        for (uint qi = 0u; qi < QB; qi++) {
            float c = corr[qi];
            float p0 = acc[qi][d0] * c;
            float p1 = acc[qi][d1] * c;
            float p2 = acc[qi][d2] * c;
            float p3 = acc[qi][d3] * c;
            for (uint j = 0u; j < tlen; j++) {
                float w = logits[qi][j];
                p0 += w * ktile[j][d0];
                p1 += w * ktile[j][d1];
                p2 += w * ktile[j][d2];
                p3 += w * ktile[j][d3];
            }
            acc[qi][d0] = p0;
            acc[qi][d1] = p1;
            acc[qi][d2] = p2;
            acc[qi][d3] = p3;
        }
        barrier();
    }

    for (uint qi = 0u; qi < QB; qi++) {
        uint i = i0 + qi;
        if (i >= p.nQ) {
            continue;
        }
        uint qOff = (i * p.nHead + h) * HD;
        for (uint d = lane; d < HD; d += LS) {
            o[qOff + d] = acc[qi][d] / lval[qi];
        }
    }
}
