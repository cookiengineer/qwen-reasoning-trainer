#version 450

// Multi-row, multi-token IQ4_XS GEMV. See gemv_multi_q4_k.comp.
layout(local_size_x = 128) in;

layout(binding = 0) readonly  buffer W { uint data[]; };
layout(binding = 1) readonly  buffer X { vec4 x[]; };
layout(binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    uint K;
    uint N;
    uint M;
    uint rowBase;
} p;

#define R 2u
#define LS 64u
#define MAXM 8u

shared float KV[16];
shared float red[R * MAXM * LS];

const float KVALS[16] = float[16](
    -127.0, -104.0, -83.0, -65.0, -49.0, -35.0, -22.0, -10.0,
    1.0, 13.0, 25.0, 38.0, 53.0, 69.0, 89.0, 113.0);

uint getb(uint o) { return (data[o >> 2u] >> ((o & 3u) * 8u)) & 0xFFu; }
float f16(uint o) { return unpackHalf2x16(getb(o) | (getb(o + 1u) << 8u)).x; }

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint lane = tid % LS;
    uint rowInGroup = tid / LS;
    if (lane < 16u) {
        KV[lane] = KVALS[lane];
    }
    barrier();

    uint n = p.rowBase + gl_WorkGroupID.x * R + rowInGroup;
    bool valid = n < p.N;
    uint bpr = p.K / 256u;

    float acc[MAXM];
    for (uint mi = 0u; mi < MAXM; mi++) {
        acc[mi] = 0.0;
    }

    if (valid) {
        for (uint sb = lane; sb < bpr * 8u; sb += LS) {
            uint b = sb >> 3u;
            uint ib = sb & 7u;
            uint base = (n * bpr + b) * 136u;
            float d = f16(base);
            uint sh = getb(base + 2u) | (getb(base + 3u) << 8u);
            uint sl = getb(base + 4u + (ib >> 1u));
            int ls = int((sl >> (4u * (ib & 1u))) & 0xFu) | int(((sh >> (2u * ib)) & 3u) << 4u);
            float dl = d * float(ls - 32);
            uint qw = (base + 8u + ib * 16u) >> 2u;
            uint xoff = b * 256u + ib * 32u;
            for (uint i = 0u; i < 4u; i++) {
                uint w = data[qw + i];
                uvec4 lo = uvec4(
                    w & 0xFu, (w >> 8u) & 0xFu, (w >> 16u) & 0xFu, (w >> 24u) & 0xFu);
                uvec4 hi = uvec4(
                    (w >> 4u) & 0xFu, (w >> 12u) & 0xFu,
                    (w >> 20u) & 0xFu, (w >> 28u) & 0xFu);
                vec4 vlo = dl * vec4(KV[lo.x], KV[lo.y], KV[lo.z], KV[lo.w]);
                vec4 vhi = dl * vec4(KV[hi.x], KV[hi.y], KV[hi.z], KV[hi.w]);
                for (uint mi = 0u; mi < p.M; mi++) {
                    uint rowOff = mi * p.K;
                    acc[mi] += dot(vlo, x[((rowOff + xoff) >> 2u) + i]) +
                               dot(vhi, x[((rowOff + xoff + 16u) >> 2u) + i]);
                }
            }
        }
    }

    for (uint mi = 0u; mi < MAXM; mi++) {
        red[(rowInGroup * MAXM + mi) * LS + lane] = acc[mi];
    }
    barrier();
    for (uint s = LS / 2u; s > 0u; s >>= 1u) {
        for (uint mi = 0u; mi < MAXM; mi++) {
            uint base = (rowInGroup * MAXM + mi) * LS;
            if (lane < s) {
                red[base + lane] += red[base + lane + s];
            }
        }
        barrier();
    }
    if (lane == 0u && valid) {
        for (uint mi = 0u; mi < p.M; mi++) {
            y[mi * p.N + n] = red[(rowInGroup * MAXM + mi) * LS];
        }
    }
}
