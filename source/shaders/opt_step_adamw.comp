#version 450

// Decoupled-weight-decay AdamW update, one invocation per element. Updates the
// parameter and the first/second moment buffers in place. Ported from
// llama.cpp ggml-vulkan opt_step_adamw.comp; the bias-correction factors
// (beta1h, beta2h) are precomputed on the host for the current step.

layout(local_size_x = 64) in;

layout(binding = 0)          buffer X  { float x[];     };
layout(binding = 1) readonly buffer G  { float grad[];  };
layout(binding = 2)          buffer GM { float gradm[]; };
layout(binding = 3)          buffer GV { float gradv[]; };

layout(push_constant) uniform P {
    uint  n;
    float alpha;
    float beta1;
    float beta2;
    float eps;
    float wd;
    float beta1h;
    float beta2h;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    float gi = grad[i];
    float gmi = gradm[i] * p.beta1 + gi * (1.0 - p.beta1);
    float gvi = gradv[i] * p.beta2 + gi * gi * (1.0 - p.beta2);

    gradm[i] = gmi;
    gradv[i] = gvi;

    float mh = gmi * p.beta1h;
    float vh = sqrt(gvi * p.beta2h) + p.eps;

    x[i] = x[i] * (1.0 - p.alpha * p.wd) - p.alpha * mh / vh;
}
