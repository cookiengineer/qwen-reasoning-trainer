#version 450

// Fused RMSNorm(out) * SiLU(z), both laid out as rows of rowLen.

layout(local_size_x = 1) in;

layout(binding = 0) readonly  buffer X { float x[]; };
layout(binding = 1) readonly  buffer W { float w[]; };
layout(binding = 2) readonly  buffer Z { float z[]; };
layout(binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P {
    uint  rowLen;
    uint  rows;
    float eps;
} p;

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= p.rows) {
        return;
    }
    uint base = r * p.rowLen;
    float ss = 0.0;
    for (uint i = 0u; i < p.rowLen; i++) {
        float v = x[base + i];
        ss += v * v;
    }
    float inv = 1.0 / sqrt(ss / float(p.rowLen) + p.eps);
    for (uint i = 0u; i < p.rowLen; i++) {
        float v = z[base + i];
        y[base + i] = x[base + i] * inv * w[i] * (v / (1.0 + exp(-v)));
    }
}
