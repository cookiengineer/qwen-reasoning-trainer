#version 450

// Fused GatedDeltaNet gate + beta sigmoid:
//   gate[d,t] = softplus(alpha[d,t] + dt[d]) * a[d]
//   beta[d,t] = sigmoid(betaRaw[d,t])
// dt and a are per-channel constants broadcast over T.

layout(local_size_x = 64) in;

layout(binding = 0) readonly  buffer Alpha   { float alpha[];   };
layout(binding = 1) readonly  buffer BetaRaw { float betaRaw[]; };
layout(binding = 2) readonly  buffer Dt      { float dt[];      };
layout(binding = 3) readonly  buffer A       { float a[];       };
layout(binding = 4) writeonly buffer Gate    { float gate[];    };
layout(binding = 5) writeonly buffer Beta    { float beta[];    };

layout(push_constant) uniform P {
    uint nV;
    uint T;
    uint base;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x + p.base;
    uint total = p.nV * p.T;
    if (i >= total) {
        return;
    }
    uint d = i % p.nV;
    float v = alpha[i] + dt[d];
    gate[i] = log(1.0 + exp(v)) * a[d];
    beta[i] = 1.0 / (1.0 + exp(-betaRaw[i]));
}
