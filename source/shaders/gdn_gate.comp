#version 450

// Fused GatedDeltaNet gate: out[d,t] = softplus(alpha[d,t] + dt[d]) * a[d].
// dt and a are per-channel constants broadcast over T.

layout(local_size_x = 64) in;

layout(binding = 0) readonly  buffer Alpha { float alpha[]; };
layout(binding = 1) readonly  buffer Dt    { float dt[];    };
layout(binding = 2) readonly  buffer A     { float a[];     };
layout(binding = 3) writeonly buffer Out   { float y[];     };

layout(push_constant) uniform P {
    uint nV;
    uint T;
    uint base;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x + p.base;
    uint total = p.nV * p.T;
    if (i >= total) {
        return;
    }
    uint d = i % p.nV;
    float v = alpha[i] + dt[d];
    y[i] = log(1.0 + exp(v)) * a[d];
}
