#version 450

// Weight-gradient GEMM for a linear layer y = W x: given the activation x and
// the output gradient dOut, produce dW.
//
//   dW[i,n] = sum_m x[i,m] * dOut[n,m]
//
// x is [In, m], dOut is [Out, m] (both GGML layout, m is the outer/stride
// dimension), dW is [In, Out] (element (i,n) at i + n*In). 64x64 (In,Out) tile,
// 16x16 threads, 4x4 register micro-tile, reduction chunk TK=16 over m.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) readonly buffer X { float x[]; };
layout(binding = 1) readonly buffer D { float dout[]; };
layout(binding = 2) writeonly buffer W { float dw[]; };

layout(push_constant) uniform P {
    uint In;
    uint Out;
    uint m;
    uint pad;
} p;

#define TIN 64
#define TOUT 64
#define TK 16
#define TIMICRO 4
#define TNMICRO 4

shared float Xs[TK][TIN + 4];
shared float Ds[TK][TOUT + 4];

void main() {
    uint tx = gl_LocalInvocationID.x;
    uint ty = gl_LocalInvocationID.y;
    uint tid = ty * 16u + tx;
    uint i0 = gl_WorkGroupID.x * TIN;
    uint n0 = gl_WorkGroupID.y * TOUT;

    float acc[TIMICRO][TNMICRO];
    for (uint i = 0u; i < TIMICRO; i++) {
        for (uint j = 0u; j < TNMICRO; j++) {
            acc[i][j] = 0.0;
        }
    }

    for (uint m0 = 0u; m0 < p.m; m0 += TK) {
        for (uint idx = tid; idx < TK * TIN; idx += 256u) {
            uint mm = idx / TIN;
            uint i = idx - mm * TIN;
            uint gg = m0 + mm;
            Xs[mm][i] = (i0 + i < p.In && gg < p.m) ? x[(i0 + i) + gg * p.In] : 0.0;
        }
        for (uint idx = tid; idx < TK * TOUT; idx += 256u) {
            uint mm = idx / TOUT;
            uint n = idx - mm * TOUT;
            uint gg = m0 + mm;
            Ds[mm][n] = (n0 + n < p.Out && gg < p.m) ? dout[(n0 + n) + gg * p.Out] : 0.0;
        }
        barrier();

        for (uint mm = 0u; mm < TK; mm++) {
            float xv[TIMICRO];
            float dv[TNMICRO];
            for (uint i = 0u; i < TIMICRO; i++) {
                xv[i] = Xs[mm][ty * TIMICRO + i];
            }
            for (uint j = 0u; j < TNMICRO; j++) {
                dv[j] = Ds[mm][tx * TNMICRO + j];
            }
            for (uint i = 0u; i < TIMICRO; i++) {
                for (uint j = 0u; j < TNMICRO; j++) {
                    acc[i][j] += xv[i] * dv[j];
                }
            }
        }
        barrier();
    }

    for (uint i = 0u; i < TIMICRO; i++) {
        uint ii = i0 + ty * TIMICRO + i;
        if (ii >= p.In) {
            continue;
        }
        for (uint j = 0u; j < TNMICRO; j++) {
            uint n = n0 + tx * TNMICRO + j;
            if (n < p.Out) {
                dw[ii + n * p.In] = acc[i][j];
            }
        }
    }
}
