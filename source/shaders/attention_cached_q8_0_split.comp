#version 450

// Stage 1 of split-context cached attention over a Q8_0 KV cache.

layout(local_size_x = 64) in;

layout(binding = 0) readonly  buffer Q { float q[]; };
layout(binding = 1) readonly  buffer K { uint data[]; } kbuf;
layout(binding = 2) readonly  buffer V { uint data[]; } vbuf;
layout(binding = 3) writeonly buffer O { float o[]; };
layout(binding = 4) writeonly buffer PART { float part[]; };

layout(push_constant) uniform P {
    uint  headDim;
    uint  nQ;
    uint  nHead;
    uint  nHeadKV;
    uint  nKV;
    uint  qStart;
    float scale;
    uint  nSplit;
    uint  keysPerSplit;
} p;

#define LS 64
#define MAX_HD 256
#define TILE 1024

shared float logits[TILE];
shared float acc[MAX_HD];
shared float qs[MAX_HD];
shared float red[LS];

uint getbK(uint o) { return (kbuf.data[o >> 2u] >> ((o & 3u) * 8u)) & 0xFFu; }
uint getbV(uint o) { return (vbuf.data[o >> 2u] >> ((o & 3u) * 8u)) & 0xFFu; }
float f16K(uint o) { return unpackHalf2x16(getbK(o) | (getbK(o + 1u) << 8u)).x; }
float f16V(uint o) { return unpackHalf2x16(getbV(o) | (getbV(o + 1u) << 8u)).x; }

float dequantK(uint token, uint kv, uint d) {
    uint bph = p.headDim / 32u;
    uint blk = (token * p.nHeadKV + kv) * bph + d / 32u;
    uint base = blk * 34u;
    uint b = getbK(base + 2u + d % 32u);
    int q = int(b);
    if (q >= 128) q -= 256;
    return f16K(base) * float(q);
}
float dequantV(uint token, uint kv, uint d) {
    uint bph = p.headDim / 32u;
    uint blk = (token * p.nHeadKV + kv) * bph + d / 32u;
    uint base = blk * 34u;
    uint b = getbV(base + 2u + d % 32u);
    int q = int(b);
    if (q >= 128) q -= 256;
    return f16V(base) * float(q);
}

void main() {
    uint qid = gl_WorkGroupID.x;
    uint split = gl_WorkGroupID.y;
    if (qid >= p.nHead * p.nQ || split >= p.nSplit) {
        return;
    }
    uint hd = p.headDim;
    if (hd > MAX_HD || hd % 32u != 0u) {
        return;
    }
    uint i = qid % p.nQ;
    uint h = qid / p.nQ;
    uint group = p.nHead / p.nHeadKV;
    uint kv = h / group;
    uint lane = gl_LocalInvocationID.x;

    uint maxJ = min(p.qStart + i + 1u, p.nKV);
    uint start = split * p.keysPerSplit;
    uint end = min(start + p.keysPerSplit, maxJ);

    uint qOff = (i * p.nHead + h) * hd;
    for (uint d = lane; d < hd; d += LS) {
        qs[d] = q[qOff + d];
        acc[d] = 0.0;
    }
    barrier();

    float m = -1e30;
    float l = 0.0;
    for (uint t0 = start; t0 < end; t0 += TILE) {
        uint tlen = min(uint(TILE), end - t0);

        for (uint e = lane; e < tlen; e += LS) {
            float dot = 0.0;
            for (uint d = 0u; d < hd; d++) {
                dot += qs[d] * dequantK(t0 + e, kv, d);
            }
            logits[e] = dot * p.scale;
        }
        barrier();

        float lm = -1e30;
        for (uint e = lane; e < tlen; e += LS) {
            lm = max(lm, logits[e]);
        }
        red[lane] = lm;
        barrier();
        for (uint s = LS / 2u; s > 0u; s >>= 1u) {
            if (lane < s) {
                red[lane] = max(red[lane], red[lane + s]);
            }
            barrier();
        }
        float newM = max(m, red[0]);
        float corr = exp(m - newM);

        float ls = 0.0;
        for (uint e = lane; e < tlen; e += LS) {
            float pe = exp(logits[e] - newM);
            logits[e] = pe;
            ls += pe;
        }
        red[lane] = ls;
        barrier();
        for (uint s = LS / 2u; s > 0u; s >>= 1u) {
            if (lane < s) {
                red[lane] += red[lane + s];
            }
            barrier();
        }
        l = l * corr + red[0];

        for (uint d = lane; d < hd; d += LS) {
            float a = acc[d] * corr;
            for (uint e = 0u; e < tlen; e++) {
                a += logits[e] * dequantV(t0 + e, kv, d);
            }
            acc[d] = a;
        }
        m = newM;
        barrier();
    }

    uint stride = hd + 2u;
    uint off = (qid * p.nSplit + split) * stride;
    if (lane == 0u) {
        part[off] = m;
        part[off + 1u] = l;
    }
    for (uint d = lane; d < hd; d += LS) {
        part[off + 2u + d] = acc[d];
    }
}
