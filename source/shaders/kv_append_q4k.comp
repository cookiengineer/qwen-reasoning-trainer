#version 450

// Quantizes one 256-value K/V head block to Q4_K and appends it to a KV cache.
// K and V are processed in parallel by the two 64-lane halves of the workgroup;
// one workgroup handles one (token, KV head). headDim must be 256.

layout(local_size_x = 128) in;

layout(binding = 0) readonly  buffer XK { vec4 x[]; } kx;
layout(binding = 1) readonly  buffer XV { vec4 x[]; } vx;
layout(binding = 2)           buffer KC { uvec4 data[]; } kcache;
layout(binding = 3)           buffer VC { uvec4 data[]; } vcache;

layout(push_constant) uniform P {
    uint headDim;
    uint capacity;
    uint nHeadKV;
    uint T;
    uint pos;
    uint base;
} p;

// First 256 entries are K, second 256 are V.
shared float vals[512];
shared float sbMin[16];
shared float sbMax[16];
shared float sbScale[16];
shared float sbMinQ[16];
shared float qd[2];
shared float qdmin[2];
shared uint scArr[16];
shared uint mArr[16];
// 144 uint slots per half (bytes of one Q4_K block).
shared uint sb[288];

float rnd(float v) { return floor(v + 0.5); }

void main() {
    uint qid = p.base + gl_WorkGroupID.x;
    if (qid >= p.T * p.nHeadKV) { return; }
    uint t = qid / p.nHeadKV;
    uint h = qid % p.nHeadKV;
    uint lane = gl_LocalInvocationID.x;
    bool isV = lane >= 64u;
    uint sl = lane & 63u;
    uint sidx = isV ? 8u : 0u;
    uint sbo = isV ? 144u : 0u;
    uint vbase = isV ? 256u : 0u;

    uint tbase = t * p.headDim * p.nHeadKV;
    uint xbase = tbase + h * p.headDim;
    uint xw = (xbase >> 2u) + sl;
    vec4 v = isV ? vx.x[xw] : kx.x[xw];
    vals[vbase + sl * 4u] = v.x;
    vals[vbase + sl * 4u + 1u] = v.y;
    vals[vbase + sl * 4u + 2u] = v.z;
    vals[vbase + sl * 4u + 3u] = v.w;
    barrier();

    if (sl < 8u) {
        float lo = vals[vbase + sl * 32u];
        float hi = lo;
        for (uint i = 1u; i < 32u; i++) {
            float x = vals[vbase + sl * 32u + i];
            lo = min(lo, x);
            hi = max(hi, x);
        }
        if (lo > 0.0) lo = 0.0;
        sbMin[sidx + sl] = lo;
        sbMax[sidx + sl] = hi;
        sbScale[sidx + sl] = hi > lo ? (hi - lo) / 15.0 : 0.0;
        sbMinQ[sidx + sl] = -lo;
    }
    barrier();

    if (sl == 0u) {
        float maxScale = 0.0;
        float maxMin = 0.0;
        for (uint i = 0u; i < 8u; i++) {
            maxScale = max(maxScale, sbScale[sidx + i]);
            maxMin = max(maxMin, sbMinQ[sidx + i]);
        }
        float dsc = maxScale / 63.0;
        float dmin = maxMin / 63.0;
        qd[isV ? 1u : 0u] = dsc;
        qdmin[isV ? 1u : 0u] = dmin;
        for (uint i = 0u; i < 8u; i++) {
            scArr[sidx + i] = dsc > 0.0 ? uint(clamp(rnd(sbScale[sidx + i] / dsc), 0.0, 63.0)) : 0u;
            mArr[sidx + i] = dmin > 0.0 ? uint(clamp(rnd(sbMinQ[sidx + i] / dmin), 0.0, 63.0)) : 0u;
        }
        uint hd = packHalf2x16(vec2(dsc, 0.0));
        uint hm = packHalf2x16(vec2(dmin, 0.0));
        sb[sbo + 0u] = hd & 0xFFu;
        sb[sbo + 1u] = (hd >> 8u) & 0xFFu;
        sb[sbo + 2u] = hm & 0xFFu;
        sb[sbo + 3u] = (hm >> 8u) & 0xFFu;
        uint packed[12];
        for (uint i = 0u; i < 12u; i++) { packed[i] = 0u; }
        for (uint j = 0u; j < 8u; j++) {
            uint l = scArr[sidx + j];
            uint m = mArr[sidx + j];
            if (j < 4u) {
                packed[j] = l;
                packed[j + 4u] = m;
            } else {
                packed[j + 4u] = (l & 0xFu) | ((m & 0xFu) << 4u);
                packed[j - 4u] |= (l >> 4u) << 6u;
                packed[j] |= (m >> 4u) << 6u;
            }
        }
        for (uint i = 0u; i < 12u; i++) {
            sb[sbo + 4u + i] = packed[i];
        }
    }
    barrier();

    float dsc = qd[isV ? 1u : 0u];
    float dmin = qdmin[isV ? 1u : 0u];
    for (uint pass = 0u; pass < 2u; pass++) {
        uint b = sl + pass * 64u;
        uint g = b / 32u;
        uint within = b % 32u;
        uint i0 = g * 64u + within;
        uint i1 = g * 64u + 32u + within;
        uint s0 = i0 / 32u;
        uint s1 = i1 / 32u;
        float d0 = dsc * float(scArr[sidx + s0]);
        float d1 = dsc * float(scArr[sidx + s1]);
        float q0 = d0 != 0.0 ? rnd((vals[vbase + i0] + dmin * float(mArr[sidx + s0])) / d0) : 0.0;
        float q1 = d1 != 0.0 ? rnd((vals[vbase + i1] + dmin * float(mArr[sidx + s1])) / d1) : 0.0;
        uint u0 = uint(clamp(q0, 0.0, 15.0));
        uint u1 = uint(clamp(q1, 0.0, 15.0));
        sb[sbo + 16u + b] = u0 | (u1 << 4u);
    }
    barrier();

    uint blk = h * p.capacity + (p.pos + t);
    uint wordBase = blk * 36u;
    for (uint i = sl; i < 9u; i += 64u) {
        uint j = sbo + i * 16u;
        uint b0 = sb[j];
        uint b1 = sb[j + 1u];
        uint b2 = sb[j + 2u];
        uint b3 = sb[j + 3u];
        uvec4 packedOut = uvec4(
            b0 | (b1 << 8u) | (b2 << 16u) | (b3 << 24u),
            sb[j + 4u] | (sb[j + 5u] << 8u) |
                (sb[j + 6u] << 16u) | (sb[j + 7u] << 24u),
            sb[j + 8u] | (sb[j + 9u] << 8u) |
                (sb[j + 10u] << 16u) | (sb[j + 11u] << 24u),
            sb[j + 12u] | (sb[j + 13u] << 8u) |
                (sb[j + 14u] << 16u) | (sb[j + 15u] << 24u));
        if (isV) {
            vcache.data[(wordBase >> 2u) + i] = packedOut;
        } else {
            kcache.data[(wordBase >> 2u) + i] = packedOut;
        }
    }
}
