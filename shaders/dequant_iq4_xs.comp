#version 450

// Dequantizes IQ4_XS blocks (136 bytes / 256 elements) to float32.

layout(local_size_x = 64) in;

layout(binding = 0) readonly  buffer W { uint data[]; };
layout(binding = 1) writeonly buffer Y { float y[]; };

layout(push_constant) uniform P { uint n; uint a; uint b; uint c; } p;

uint getb(uint off) { return (data[off >> 2u] >> ((off & 3u) * 8u)) & 0xFFu; }
float f16(uint off) { return unpackHalf2x16(getb(off) | (getb(off + 1u) << 8u)).x; }

const float KV[16] = float[16](
    -127.0, -104.0, -83.0, -65.0, -49.0, -35.0, -22.0, -10.0,
    1.0, 13.0, 25.0, 38.0, 53.0, 69.0, 89.0, 113.0);

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) {
        return;
    }
    uint inblk = p.a + gid;
    uint oublk = p.b + gid;
    uint base = inblk * 136u;
    float d = f16(base);
    uint sh = getb(base + 2u) | (getb(base + 3u) << 8u);
    uint o = oublk * 256u;

    for (uint ib = 0u; ib < 8u; ib++) {
        uint sl = getb(base + 4u + (ib >> 1u));
        int ls = int((sl >> (4u * (ib & 1u))) & 0xFu) | int(((sh >> (2u * ib)) & 3u) << 4u);
        float dl = d * float(ls - 32);
        uint q = base + 8u + ib * 16u;
        for (uint j = 0u; j < 16u; j++) {
            uint qb = getb(q + j);
            y[o + j] = dl * KV[qb & 0xFu];
            y[o + j + 16u] = dl * KV[qb >> 4];
        }
        o += 32u;
    }
}
