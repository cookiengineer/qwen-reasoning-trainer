#version 450

layout(local_size_x = 64) in;

layout(binding = 0) readonly  buffer A { float a[]; };
layout(binding = 1) readonly  buffer B { float b[]; };
layout(binding = 2) writeonly buffer O { float o[]; };

layout(push_constant) uniform P {
    uint n;
    uint op;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    float r;
    if (p.op == 0u)      r = a[i] + b[i];
    else if (p.op == 1u) r = a[i] - b[i];
    else if (p.op == 2u) r = a[i] * b[i];
    else if (p.op == 3u) r = a[i] / b[i];
    else                 r = a[i] * (1.0 - a[i]) * b[i];
    o[i] = r;
}
