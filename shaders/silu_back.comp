#version 450

// SiLU backward: dx = dOut * silu'(x), silu'(x) = sigmoid(x)*(1 + x*(1-sigmoid(x))).

layout(local_size_x = 64) in;

layout(binding = 0) readonly buffer X    { float x[];    };
layout(binding = 1) readonly buffer DOut { float dout[]; };
layout(binding = 2) writeonly buffer DX  { float dx[];   };

layout(push_constant) uniform P { uint n; uint pad0; uint pad1; uint pad2; } p;

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= p.n) {
        return;
    }
    float v = x[gid];
    float s = 1.0 / (1.0 + exp(-v));
    dx[gid] = dout[gid] * s * (1.0 + v * (1.0 - s));
}
