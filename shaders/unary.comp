#version 450

layout(local_size_x = 64) in;

layout(binding = 0) readonly  buffer In  { float x[]; };
layout(binding = 1) writeonly buffer Out { float y[]; };

layout(push_constant) uniform P {
    uint  n;
    uint  op;
    float s;
    uint  base;
} p;

float silu(float v) { return v / (1.0 + exp(-v)); }

void main() {
    uint i = gl_GlobalInvocationID.x + p.base;
    if (i >= p.n) {
        return;
    }
    float v = x[i];
    float r;
    switch (p.op) {
        case 0u: r = silu(v); break;
        case 1u: r = 1.0 / (1.0 + exp(-v)); break;
        case 2u: r = log(1.0 + exp(v)); break;
        case 3u: r = 0.5 * v * (1.0 + tanh(0.7978845608 * (v + 0.044715 * v * v * v))); break;
        case 4u: r = -v; break;
        case 5u: r = exp(v); break;
        case 6u: r = v * v; break;
        case 7u: r = sqrt(v); break;
        case 8u: r = tanh(v); break;
        case 9u: r = v * p.s; break;
        default: r = v; break;
    }
    y[i] = r;
}
